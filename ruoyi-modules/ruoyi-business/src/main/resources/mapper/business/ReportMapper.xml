<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.dromara.business.mapper.ReportMapper">

    <!--
    查询今日注册用户数
    @result java.lang.Integer 返回今日注册用户总数
    -->
    <select id="queryRegisterCount" resultType="java.lang.Integer">
        select count(1)
        from `sys_user`
        where to_days(create_time) = to_days(now())
    </select>

    <!--
    查询今日成功支付的文件传输记录数
    @result java.lang.Integer 返回今日支付状态为'S'的文件传输记录总数
    -->
    <select id="queryFiletransCount" resultType="java.lang.Integer">
        select count(1)
        from biz_filetrans
        where to_days(create_time) = to_days(now())
          and pay_status = 'S'
    </select>

    <!--
    查询今日成功支付的文件传输总时长(秒)
    @result java.lang.Integer 返回今日支付状态为'S'的文件传输总秒数
    对于文件传输时长查询，使用了IFNULL函数（MySQL特有），作用与COALESCE相同
    -->
    <select id="queryFiletransSecond" resultType="java.lang.Integer">
        select IFNULL(sum(second), 0)
        from biz_filetrans
        where to_days(create_time) = to_days(now())
          and pay_status = 'S'
    </select>

    <!--
    查询今日成功订单数量
    @result java.lang.Integer 返回今日状态为'S'的订单总数
    -->
    <select id="queryOrderCount" resultType="java.lang.Integer">
        select count(1)
        from order_info
        where to_days(order_at) = to_days(now())
          and status = 'S';
    </select>

    <!--
    查询今日成功订单总金额
    @result java.math.BigDecimal 返回今日状态为'S'的订单金额总和
    对于订单金额查询，使用了COALESCE函数（MySQL和PostgreSQL都支持），当sum结果为NULL时返回0
    -->
    <select id="queryOrderAmount" resultType="java.math.BigDecimal">
        select COALESCE(sum(amount), 0)
        from order_info
        where
            order_at >= curdate()
          and status = 'S'
    </select>

    <!--
     * 查询最近30天每日注册用户数统计
     *
     * @resultType org.dromara.common.dependency.business.domain.vo.StatisticDateVo 返回统计结果对象列表
     *             包含日期和对应注册人数
     *
     * 查询逻辑：
     * 1. 从系统用户表中筛选出最近30天的注册记录
     * 2. 按'月-日'格式分组统计每日注册人数
     * 3. 返回包含日期和对应数量的统计结果
     -->
    <select id="query30RegisterCount" resultType="org.dromara.common.dependency.business.domain.vo.StatisticDateVo">
        <!-- 查询最近30天每日注册数据 -->
        SELECT
        date_format( create_time, '%m-%d' ) AS `date`,
        count( 1 ) AS num
        FROM sys_user
        <!-- 筛选条件：创建时间在最近30天内 -->
        where date_sub(curdate(), interval 29 day) <![CDATA[<=]]> create_time
        <!-- 按日期分组统计 -->
        group by date_format(create_time,'%m-%d')
    </select>

    <!--
    查询最近30天文件传输数量统计
    @resultType org.dromara.common.dependency.business.domain.vo.StatisticDateVo 返回统计结果对象
    统计内容：
    - date: 日期(MM-DD格式)
    - filetransCount: 当日文件传输数量
    查询条件：
    - 创建时间在最近30天内
    - 支付状态为'S'(成功)
    -->
    <select id="query30FiletransCount" resultType="org.dromara.common.dependency.business.domain.vo.StatisticDateVo">
        select date_format(create_time,'%m-%d') as `date`, count(1) as filetransCount
        from biz_filetrans
        where date_sub(curdate(), interval 29 day) <![CDATA[<=]]> create_time
          and pay_status = 'S'
        group by date_format(create_time, '%m-%d')
    </select>

    <!--
    查询最近30天文件传输总时长统计(秒)
    @resultType org.dromara.common.dependency.business.domain.vo.StatisticDateVo 返回统计结果对象
    统计内容：
    - date: 日期(MM-DD格式)
    - filetransSecond: 当日文件传输总秒数
    查询条件：
    - 创建时间在最近30天内
    - 支付状态为'S'(成功)
    -->
    <select id="query30FiletransSecond" resultType="org.dromara.common.dependency.business.domain.vo.StatisticDateVo">
        select date_format(create_time,'%m-%d') as `date`, sum(second) as filetransSecond
        from biz_filetrans where date_sub(curdate(), interval 29 day) <![CDATA[<=]]> create_time and pay_status = 'S'
        group by date_format(create_time,'%m-%d')
    </select>

    <!--
    查询最近30天订单数量统计
    @resultType org.dromara.common.dependency.business.domain.vo.StatisticDateVo 返回统计结果对象
    统计内容：
    - date: 日期(MM-DD格式)
    - orderCount: 当日订单数量
    查询条件：
    - 订单时间在最近30天内
    - 订单状态为'S'(成功)
    -->
    <select id="query30OrderCount" resultType="org.dromara.common.dependency.business.domain.vo.StatisticDateVo">
        select date_format(`order_at`,'%m-%d') as `date`, count(1) as orderCount
        from order_info
        where date_sub(curdate(), interval 29 day) <![CDATA[<=]]> `order_at`
          and status = 'S'
        group by date_format(`order_at`,'%m-%d')
    </select>

    <!--
     * 查询近30天订单金额统计
     *
     * 功能说明：
     * 1. 统计最近30天内每天的订单总金额
     * 2. 按"月-日"格式分组展示数据
     *
     * 查询条件：
     * 1. 订单创建时间在最近30天内（date_sub(curdate(), interval 29 day) <= order_at）
     * 2. 订单状态为'S'(成功状态)
     *
     * 返回结果：
     * @resultType org.dromara.common.dependency.business.domain.vo.StatisticDateVo
     *   - date: 格式化后的日期(MM-dd格式)
     *   - orderAmount: 当日订单总金额
     -->
    <select id="query30OrderAmount" resultType="org.dromara.common.dependency.business.domain.vo.StatisticDateVo">
        <!-- 查询最近30天的每日订单金额汇总 -->
        select date_format(`order_at`,'%m-%d') as `date`, sum(amount) as orderAmount
        from order_info
        <!-- 时间范围条件：最近30天且状态为成功的订单 -->
        where date_sub(curdate(), interval 29 day) <![CDATA[<=]]> `order_at`
        and status = 'S'
        <!-- 按日期格式分组 -->
        group by date_format(`order_at`, '%m-%d')
    </select>


</mapper>
